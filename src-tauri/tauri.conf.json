{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimpleSafeBanking",
  "version": "0.1.0",
  "identifier": "app.simplesafebanking.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5173/app",
    "beforeDevCommand": {
      "script": "node scripts/desktop/devServer.mjs",
      "cwd": "..",
      "wait": false
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Finance",
    "shortDescription": "Private, local-first personal finance",
    "copyright": "SimpleSafeBanking",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "resources/staged/backend/": "backend/",
      "resources/staged/dist/": "dist/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
