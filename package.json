{
  "name": "simplesafebanking",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "local": "node scripts/startPersonalDev.mjs --use-saved-token --open",
    "dev": "vite",
    "dev:personal": "node scripts/startPersonalDev.mjs",
    "setup:personal-dev": "npm install --prefix backend",
    "build": "vite build",
    "build:desktop-web": "vite build --mode desktop --outDir dist-desktop --emptyOutDir",
    "check:bundle": "node scripts/checkBundleBudget.mjs",
    "build:vendor-knowledge": "node scripts/buildVendorKnowledge.mjs",
    "build:bvb-instruments": "node scripts/buildBvbInstruments.mjs",
    "discover:vendor-knowledge:ro": "node scripts/discoverRomanianVendors.mjs",
    "lint": "eslint .",
    "privacy:scan": "scripts/privacy-scan.sh",
    "preview": "vite preview",
    "test": "npm run test:frontend && npm run test:backend && npm run test:git-privacy",
    "test:frontend": "vitest run src/test",
    "test:backend": "vitest run backend/*.test.js",
    "test:contract": "vitest run backend/contract",
    "test:git-privacy": "vitest run scripts/*.test.js",
    "test:watch": "vitest",
    "test:smoke": "vitest run --reporter=verbose",
    "check": "npm run lint && npm run test && npm run build && npm run check:bundle && npm run privacy:scan",
    "check:release": "npm run check",
    "auto-unlock": "node scripts/autoUnlock.mjs",
    "recovery:setup": "node scripts/recoverySetup.mjs",
    "recovery:password": "node scripts/passwordRecoverySetup.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:dev": "tauri dev",
    "desktop:prepare": "node scripts/desktop/prepareSidecar.mjs",
    "desktop:build": "npm run build:desktop-web && npm run desktop:prepare && tauri build --bundles app",
    "desktop:check": "node scripts/desktop/prepareSidecar.mjs --placeholders && cd src-tauri && cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings && cargo test --locked",
    "desktop:audit": "cd src-tauri && cargo audit",
    "check:all": "npm run check && npm run test:contract && npm run desktop:check",
    "desktop:import-dev-data": "node scripts/desktop/importDevData.mjs"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "fuse.js": "^7.4.2",
    "lucide-react": "^1.17.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.6",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24"
  }
}
