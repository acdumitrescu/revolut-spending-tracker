# Vite mode "desktop" (npm run build:desktop-web). Not a secret file: no tokens here.
# The desktop shell injects the per-launch sync token at runtime (docs/adr/0003).
VITE_DEPLOYMENT_PROFILE=private-sync
VITE_PRIVATE_SYNC_ENABLED=true
VITE_PRIVATE_SYNC_AUTO_AUTH=false
VITE_ENCRYPTED_STORAGE=true
VITE_LOCAL_USERS=true
VITE_PRIVATE_BACKUP_ENABLED=true
VITE_API_BASE_PATH=/api
VITE_FX_REFRESH_ENABLED=true
